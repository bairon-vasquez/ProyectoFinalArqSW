# Configuración de adaptadores del sistema de boletería.
# Copie este archivo como .env y ajuste los valores. El .env no se versiona.
# Este archivo no contiene secretos reales: reemplace cada <marcador> por su valor local.
#
# Cambiar un adaptador es editar una variable y reiniciar el backend:
# no se edita código ni cambia ningún archivo del núcleo.
#
# Si PASARELA_PAGO, MENSAJERIA o SIA faltan o tienen un valor que no está en la lista
# de valores válidos, el backend no arranca y muestra los valores válidos (ADR-005).
# [NECESITA ACLARACIÓN: ¿qué pasa si faltan RELOJ, DATABASE_URL o CORS_ORIGEN? El ADR-005
# solo cubre las tres primeras. Mientras tanto, defina todas las variables.]
# El "por defecto" de cada variable indica el valor de este ejemplo.

# --- Pasarela de pago -------------------------------------------------------
# Valores válidos: simulada_a | simulada_b
# Por defecto en este ejemplo: simulada_a
# Activa: el adaptador de pasarela correspondiente, en
#   src/backend/adaptadores/salida/pasarelas/
#   (simulada_a = pasarela simulada A, simulada_b = pasarela simulada B).
PASARELA_PAGO=simulada_a

# --- Servicio de mensajería -------------------------------------------------
# Valores válidos: consola | archivo
# Por defecto en este ejemplo: consola
# Activa: el adaptador de mensajería, en
#   src/backend/adaptadores/salida/mensajeria/
#   (consola = los mensajes se muestran en la consola;
#    archivo = los mensajes se escriben en un archivo de registro).
MENSAJERIA=consola

# --- SIA (Sistema de Información Académica) ---------------------------------
# Valores válidos: simulado
# Por defecto en este ejemplo: simulado
# Activa: el adaptador del SIA simulado, en
#   src/backend/adaptadores/salida/sia/
SIA=simulado

# Archivo con los estudiantes y egresados del SIA simulado.
# Valor válido: ruta de un archivo JSON, relativa a la raíz del repositorio.
# Por defecto en este ejemplo: src/backend/adaptadores/salida/sia/datos/sia.json
# Lo lee el adaptador SIA=simulado; con otro valor de SIA no se usa.
SIA_DATOS=src/backend/adaptadores/salida/sia/datos/sia.json

# --- Reloj ------------------------------------------------------------------
# Valores válidos: sistema | controlable
# Por defecto en este ejemplo: sistema
# Activa: el adaptador de reloj, en
#   src/backend/adaptadores/salida/reloj/
#   (sistema = RelojSistema, hora real;
#    controlable = RelojControlable, que se adelanta solo en modo demo).
# Use "controlable" únicamente en la demostración (ADR-007).
RELOJ=sistema

# --- Base de datos ----------------------------------------------------------
# Valor válido: URL de conexión a PostgreSQL con el controlador psycopg.
# Por defecto en este ejemplo: la del servicio de docker-compose.yml en localhost:5432.
# Activa: el adaptador de persistencia (SQLAlchemy y Alembic),
#   en src/backend/adaptadores/salida/persistencia/
# Usuario, clave y base deben coincidir con POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB.
DATABASE_URL=postgresql+psycopg://<usuario>:<clave>@localhost:5432/<bd>

# Datos con los que docker-compose.yml crea la base. Defínalos antes de levantarla.
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<clave>
POSTGRES_DB=<bd>

# --- API y frontend ---------------------------------------------------------
# Valor válido: origen (esquema, host y puerto) desde el que se sirve el frontend Angular.
# Por defecto en este ejemplo: http://localhost:4200
# Activa: la regla CORS del adaptador de entrada (FastAPI), que permite
#   las llamadas del frontend a la API.
CORS_ORIGEN=http://localhost:4200
